# Settings for docker-compose.yml. Copy to .env (git ignores that file) and fill in the values.
# Never commit .env or put real values in this example.

# Password of the PostgreSQL user. Use letters and digits (it ends up in a connection string where ';' and '=' have a meaning):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signing key of the access tokens, at least 32 characters (the API refuses to start otherwise):
#   openssl rand -base64 48
JWT_KEY=

# OAuth client id of the frontend (public, from Google Cloud Console). Required: Google sign-in verifies ID tokens against it.
GOOGLE_CLIENT_ID=

# Free MediatR Community key from https://luckypennysoftware.com (expires after a year). Optional: without it the app works,
# MediatR just logs a license warning at startup.
MEDIATR_LICENSE_KEY=

# Optional, defaults in brackets.
# JWT_ISSUER=hannas-habits
# JWT_AUDIENCE=hannas-habits-ui
# Origin of the frontend, for CORS [http://localhost:5173]
# CORS_ORIGIN=http://localhost:5173
# Host port of the API [8080]
# API_PORT=8080
