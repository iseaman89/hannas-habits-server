# Manual API smoke tests (JetBrains HTTP Client syntax; response handlers store tokens/ids for the next requests).
# Run top to bottom: register (once) or login first, then the rest.
# Use https: the API redirects http -> https, and a CORS preflight / POST to the http URL would get a 307.
# The ASP.NET dev certificate must be trusted: dotnet dev-certs https --trust

@host = https://localhost:7054
# Throw-away dev account - not a real password.
@email = dev@example.com
@password = Dev-Passw0rd!
@date = 2026-10-08

### Register (first time only) - 200 with { user, tokens }; 409 if the email exists, 400 for a weak password
# displayName is optional (max 100 chars, trimmed); user.displayName falls back to the email's local part.
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "displayName": "Dev User" }

> {%
    client.global.set("accessToken", response.body.tokens.accessToken);
    client.global.set("refreshToken", response.body.tokens.refreshToken);
%}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

> {%
    client.global.set("accessToken", response.body.tokens.accessToken);
    client.global.set("refreshToken", response.body.tokens.refreshToken);
%}

### Google login - 200 with { user, tokens }
# Needs a real Google ID token (JWT) issued for our client id (Google:ClientId), e.g. from the frontend's Google sign-in.
# 401 if the token is invalid, 409 if a password account with that email already exists.
POST {{host}}/api/auth/google
Content-Type: application/json

{ "idToken": "<paste a Google ID token here>" }

> {%
    client.global.set("accessToken", response.body.tokens.accessToken);
    client.global.set("refreshToken", response.body.tokens.refreshToken);
%}

### Refresh the token pair - 200 with { user, tokens }
# A refresh token works exactly once: the response carries a NEW one (the handler below stores it).
# Sending an already used one again counts as theft - 401 and every session of the user is revoked.
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

> {%
    client.global.set("accessToken", response.body.tokens.accessToken);
    client.global.set("refreshToken", response.body.tokens.refreshToken);
%}

### Create a habit - 201 + Location header
# recurrence = the rule that decides on which days the habit is due; omit it for "every day". kind is one of
#   weekly            weekdays (0 = Sunday ... 6 = Saturday), interval = every N weeks (1..52, default 1)
#   everyNDays        interval (2..365), counted from anchor
#   monthlyOnWeekday  occurrence (first | second | third | fourth | last) + weekday
#   monthlyOnDate     dayOfMonth (1..31; a month without that date uses its last day)
#   timesPerWeek      times (1..7) in every calendar week (Monday to Sunday), on any days - no due day
#   timesPerMonth     times (1..28) in every calendar month, on any days - no due day
# anchor = the day the rhythm counts from (every N weeks with N > 1, every N days); omitted = the start date.
# startDate = first day the habit applies (yyyy-MM-dd, your local date; 2000-01-01 .. 2100-12-31); omit it for "today".
POST {{host}}/api/habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Read 20 pages",
  "description": "Before bed",
  "recurrence": { "kind": "weekly", "weekdays": [1, 2, 3, 4, 5] },
  "startDate": "{{date}}"
}

> {%
    client.global.set("habitId", response.body.id);
%}

### Create a habit that repeats every second week - 201
POST {{host}}/api/habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Gym",
  "recurrence": { "kind": "weekly", "weekdays": [1, 4], "interval": 2, "anchor": "{{date}}" },
  "startDate": "{{date}}"
}

### Create a habit for the last Saturday of the month - 201
POST {{host}}/api/habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Clean the flat", "recurrence": { "kind": "monthlyOnWeekday", "occurrence": "last", "weekday": 6 } }

### Create a habit for the 15th of every month - 201
POST {{host}}/api/habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Pay the rent", "recurrence": { "kind": "monthlyOnDate", "dayOfMonth": 15 } }

### Create a habit that repeats every 3 days - 201
POST {{host}}/api/habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Water the plants", "recurrence": { "kind": "everyNDays", "interval": 3 } }

### Create a habit with a quota: 3 times a week, on any days - 201
# No day is due: any day can be ticked and counts. The overview's quotaPeriods say how far each week is, and the streak
# counts the weeks (timesPerMonth: months) that reached the count.
POST {{host}}/api/habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Go to the gym", "recurrence": { "kind": "timesPerWeek", "times": 3 } }

### List habits
GET {{host}}/api/habits
Authorization: Bearer {{accessToken}}

### Habit overview for the month grid / the "today" panel - 200 (each habit also carries taggedDays: [{ date, tags }] of the range)
# One call instead of 1 + N: per habit its recurrence rule, startDate, scheduledDates (the days between from and to
# the habit is due on: the rule applied, none before startDate), the completed days between from and to (inclusive,
# both required, at most 366 days apart, oldest first) and currentStreak as of asOf (= your local today; omitted =
# the server's UTC date). The streak counts due days in a row back from asOf, independent of from/to (it can span months).
# For a quota rule (timesPerWeek / timesPerMonth) every day from startDate is listed in scheduledDates (any day can be
# ticked), quotaPeriods lists each week/month that touches the range as { from, to, done } - counted over the whole
# period - and the streak counts weeks/months in a row that reached the count (the running one is skipped while open).
GET {{host}}/api/habits/overview?from=2026-10-01&to=2026-10-31&asOf={{date}}
Authorization: Bearer {{accessToken}}

### Statistics for the month: per habit and per part what was planned and done, and when it was last done - 200
# planned = the due days up to asOf (asOf itself only once it is done); a quota counts weeks / months that ended in the
# range (unit: days | weeks | months). lastDoneOn reaches outside the range. from/to required, at most 366 days apart.
GET {{host}}/api/habits/statistics?from=2026-10-01&to=2026-10-31&asOf={{date}}
Authorization: Bearer {{accessToken}}

### Get one habit
GET {{host}}/api/habits/{{habitId}}
Authorization: Bearer {{accessToken}}

### Update a habit - 204 (replaces title, description and rule; the recurrence is required here)
# Send back the anchor the habit has to keep its rhythm: moving startDate must not shift it. startDate omitted = unchanged.
PUT {{host}}/api/habits/{{habitId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Read 30 pages",
  "description": "Before bed",
  "recurrence": { "kind": "weekly", "weekdays": [0, 1, 2, 3, 4, 5, 6] }
}

### Mark a day as completed - 200; repeating it returns the same record (idempotent)
PUT {{host}}/api/habits/{{habitId}}/records/{{date}}
Authorization: Bearer {{accessToken}}

### List records (from/to optional, inclusive)
GET {{host}}/api/habits/{{habitId}}/records?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{accessToken}}

### Unmark a day - 204 (404 if the day was not marked)
DELETE {{host}}/api/habits/{{habitId}}/records/{{date}}
Authorization: Bearer {{accessToken}}

### Create a tag - 201 with { id, name }. Idempotent by name, ignoring case: an existing tag answers 200 with that tag.
# A tag belongs to the user, not to a habit; at most 200 per user, name at most 30 characters (trimmed).
POST {{host}}/api/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "krank" }

> {%
    client.global.set("tagId", response.body.id);
%}

### List the tags with their use - 200 [{ id, name, useCount, habitUseCount, lastUsedOn }]
# With habitId the habit's own days come first (for suggestions while typing); habitUseCount is 0 without it.
GET {{host}}/api/tags?habitId={{habitId}}
Authorization: Bearer {{accessToken}}

### Put the tag on a day of the habit - 200 with the day's tags { date, tags: [{ id, name }] }. Idempotent; at most 10 per day.
# Independent of the completion mark: a missed day can be tagged.
PUT {{host}}/api/habits/{{habitId}}/days/{{date}}/tags/{{tagId}}
Authorization: Bearer {{accessToken}}

### Take the tag off the day - 200 with the day's tags. Idempotent: a tag the day does not have is no error.
DELETE {{host}}/api/habits/{{habitId}}/days/{{date}}/tags/{{tagId}}
Authorization: Bearer {{accessToken}}

### Rename a tag - 200 { id, name, merged }. A name another tag already has (ignoring case) MERGES the two:
### the days go to the other tag, this tag is gone, merged = true and id is the surviving tag's id.
PUT {{host}}/api/tags/{{tagId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Erkältet" }

### Delete a tag - 200 { removedFromDays }; it comes off every day it was on (a day that held only this tag is gone).
DELETE {{host}}/api/tags/{{tagId}}
Authorization: Bearer {{accessToken}}

### Add a sub-habit ("Legs" of "Sport") - 201 with { id, title, weekdays }. At most 10 per habit; the title is unique per habit
### (ignoring case); weekdays are 0 = Sunday ... 6 = Saturday and must be days the habit itself is planned on (400 detail otherwise).
# A sub-habit is due where the habit is due AND the weekday is one of its own - a later change of the habit's rhythm carries it along.
POST {{host}}/api/habits/{{habitId}}/sub-habits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Legs", "weekdays": [1, 5] }

> {%
    client.global.set("subHabitId", response.body.id);
%}

### Rename / move a sub-habit - 200 { id, title, weekdays }. Its ticks stay.
PUT {{host}}/api/habits/{{habitId}}/sub-habits/{{subHabitId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Legs & glutes", "weekdays": [1] }

### Tick a sub-habit on a day - 200 { date, habitCompleted, completedSubHabitIds }. Idempotent.
# The habit's day follows: when this was the last of the day's due sub-habits, habitCompleted is true (and the habit has a record that day).
PUT {{host}}/api/habits/{{habitId}}/sub-habits/{{subHabitId}}/records/{{date}}
Authorization: Bearer {{accessToken}}

### Take the tick back - 200 with the day after the call. Idempotent. A day that was done because all its due parts were is not done any more.
DELETE {{host}}/api/habits/{{habitId}}/sub-habits/{{subHabitId}}/records/{{date}}
Authorization: Bearer {{accessToken}}

### Remove a sub-habit with all its ticks - 204. The habit's own days stay as they are.
DELETE {{host}}/api/habits/{{habitId}}/sub-habits/{{subHabitId}}
Authorization: Bearer {{accessToken}}

### Delete the habit (its records go with it) - 204
DELETE {{host}}/api/habits/{{habitId}}
Authorization: Bearer {{accessToken}}

### Save the diary entry of a day - 204. One document per user+date: creates or replaces it (idempotent, last write wins).
### Everything left out is cleared. mood 1 (rough) - 5 (great), body/mind 0-100. A completely empty document removes the entry.
PUT {{host}}/api/daily-diaries/{{date}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "mood": 4,
  "body": 70,
  "mind": 55,
  "highlight": "A good day.",
  "grateful": ["Coffee", "Sunshine"],
  "learned": ["Waiting pays off"],
  "tasks": [
    { "title": "Call mum", "done": true },
    { "title": "Write the report", "done": false }
  ]
}

### Get the entry of a day - 200; 404 = nothing written for that day yet
GET {{host}}/api/daily-diaries/{{date}}
Authorization: Bearer {{accessToken}}

### Days with an entry and their mood, oldest first (calendar) - from/to inclusive and optional
GET {{host}}/api/daily-diaries?from=2026-01-01&to=2026-12-31
Authorization: Bearer {{accessToken}}

### Delete the entry of a day - 204; 404 if there is none
DELETE {{host}}/api/daily-diaries/{{date}}
Authorization: Bearer {{accessToken}}

### Resolutions of a year, in creation order - 200; a year without any answers with an empty list. Years 2000-2100.
GET {{host}}/api/resolutions/2026
Authorization: Bearer {{accessToken}}

### Add a resolution - 201 with the item (Location = the year's list). At most 50 per year (400 beyond that).
# habitId is optional: a habit of the user that tracks this resolution (400 errors.habitId if it is not theirs).
POST {{host}}/api/resolutions/2026/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Read 12 books", "habitId": "{{habitId}}" }

> {%
    client.global.set("resolutionId", response.body.id);
%}

### Mark a resolution kept - 204. The PUT replaces title, kept and habit link: leave habitId out to remove the link,
### "kept" is required (400 if missing, so a forgotten value cannot re-open it). 404 for a wrong year or another user's item.
PUT {{host}}/api/resolutions/2026/items/{{resolutionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Read 12 books", "kept": true, "habitId": "{{habitId}}" }

### Delete a resolution - 204; 404 if there is none. (Deleting the linked habit keeps the resolution and only clears the link.)
DELETE {{host}}/api/resolutions/2026/items/{{resolutionId}}
Authorization: Bearer {{accessToken}}

### Revoke one refresh token (logout of this session) - 204, also for unknown / already revoked tokens
POST {{host}}/api/auth/revoke
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Revoke all refresh tokens of the user - 204
POST {{host}}/api/auth/revoke-all
Authorization: Bearer {{accessToken}}
